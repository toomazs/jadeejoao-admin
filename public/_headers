# Hashed build assets never change under the same name — cache them hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The panel itself must always be the latest one.
/
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # The panel frames the public site to preview edits, never the other way
  # round: nothing may embed the panel, where a session lives.
  Content-Security-Policy: frame-ancestors 'none'
